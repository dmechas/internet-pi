# {{ ansible_managed }}
## MKTXP exporter (process) settings. Unlisted keys use the built-in defaults.

[MKTXP]
    listen = '0.0.0.0:49090'
    socket_timeout = 5

    initial_delay_on_failure = 120
    max_delay_on_failure = 900
    delay_inc_div = 5

    bandwidth = False
    minimal_collect_interval = 5
    verbose_mode = False
