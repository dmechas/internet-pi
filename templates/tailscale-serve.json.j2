{
  "TCP": {
    "443": { "HTTPS": true }
  },
  "Web": {
    "${TS_CERT_DOMAIN}:443": {
      "Handlers": {
        "/": {
          "Proxy": "{{ tailscale_funnel_target }}"
        }
      }
    }
  }{% if tailscale_funnel_enable | default(false) | bool %},
  "AllowFunnel": {
    "${TS_CERT_DOMAIN}:443": true
  }{% endif %}
}
