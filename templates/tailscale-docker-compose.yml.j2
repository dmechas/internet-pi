# {{ ansible_managed }}
---
services:
  tailscale:
    image: tailscale/tailscale:latest
    container_name: tailscale-funnel
    hostname: {{ tailscale_hostname }}  # becomes {{ tailscale_hostname }}.<tailnet>.ts.net
    network_mode: host                  # lets it reach services on the Pi directly
    restart: unless-stopped
    environment:
      - TS_AUTHKEY=${TS_AUTHKEY}        # read from the .env file next to this compose file
      - TS_STATE_DIR=/var/lib/tailscale
      - TS_USERSPACE=true               # no /dev/net/tun or NET_ADMIN needed
      - TS_SERVE_CONFIG=/config/serve.json
      - TS_EXTRA_ARGS=--advertise-tags={{ tailscale_advertise_tags }}
    volumes:
      - ./ts-state:/var/lib/tailscale
      - ./serve.json:/config/serve.json:ro
