services:
  jellyfin:
    image: jellyfin/jellyfin
    container_name: jellyfin
    ports:
      - 8096:8096/tcp
      - 7359:7359/udp
    volumes:
      - './config:/config'
      - './cache:/cache'
      - type: bind
        source: /mnt/storage/movies
        target: /media/movies
      - type: bind
        source: /mnt/storage/tvseries
        target: /media/tvseries
    restart: 'unless-stopped'